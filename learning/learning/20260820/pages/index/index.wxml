<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state">
    <view class="state-icon">🕐</view>
    <view>正在获取天气…</view>
  </view>

  <!-- 出错提示 -->
  <view wx:elif="{{error}}" class="state">
    <view class="state-icon">{{errorIcon || '😅'}}</view>
    <view class="error-text">{{error}}</view>
    <button class="retry-btn" bindtap="loadByLocation">重新定位</button>
  </view>

  <block wx:else>
    <!-- 顶部：城市 + 搜索 -->
    <view class="topbar">
      <view class="city">{{city}}</view>
      <input
        class="search-input"
        placeholder="输入城市名，如：北京"
        confirm-type="search"
        bindinput="onCityInput"
        bindconfirm="onCitySearch"
      />
    </view>

    <!-- 当前天气 -->
    <view class="hero">
      <view class="hero-city">
        {{city}}
        <text wx:if="{{country}}" class="hero-country">{{country}}</text>
      </view>
      <view class="hero-icon">{{nowIcon}}</view>
      <view class="hero-temp">{{now.temp}}°</view>
      <view class="hero-text">{{nowText || now.text}}</view>
      <view class="hero-meta">{{now.windDir}} {{now.windScale}} 级 · 体感 {{now.feelsLike}}°</view>
      <view class="hero-update">更新于 {{updateTime}}</view>
    </view>

    <!-- 天气详情 -->
    <view class="grid">
      <view class="grid-item">
        <view class="grid-value">{{now.humidity}}%</view>
        <view class="grid-label">湿度</view>
      </view>
      <view class="grid-item">
        <view class="grid-value">{{now.pressure}} hPa</view>
        <view class="grid-label">气压</view>
      </view>
      <view class="grid-item">
        <view class="grid-value">{{now.vis}} km</view>
        <view class="grid-label">能见度</view>
      </view>
      <view class="grid-item">
        <view class="grid-value">{{now.windSpeed}} km/h</view>
        <view class="grid-label">风速</view>
      </view>
    </view>

    <!-- 未来三天 -->
    <view class="forecast">
      <view class="section-title">未来三天</view>
      <view class="forecast-list">
        <view class="forecast-item" wx:for="{{daily}}" wx:key="fxDate">
          <view class="forecast-day">{{item.dateLabel}}</view>
          <view class="forecast-icon">{{item.icon}}</view>
          <view class="forecast-text">{{item.textDay}}</view>
          <view class="forecast-temp">{{item.tempMin}}° ~ {{item.tempMax}}°</view>
        </view>
      </view>
    </view>

    <view class="tip">下拉可刷新天气</view>
  </block>

  <!-- 城市选择弹窗 -->
  <view wx:if="{{showCityPicker}}" class="picker-mask" bindtap="onCloseCityPicker">
    <view class="picker-modal" catchtap="">
      <view class="picker-title">找到多个城市，请选择</view>
      <view class="picker-list">
        <view
          class="picker-item"
          wx:for="{{cityList}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onPickCity"
        >
          <view class="picker-city">
            <text>{{item.name}}</text>
            <text wx:if="{{item.showBoth}}" class="picker-original">（{{item.originalName}}）</text>
          </view>
          <view class="picker-country">{{item.country}}</view>
        </view>
      </view>
      <view class="picker-cancel" bindtap="onCloseCityPicker">取消</view>
    </view>
  </view>
</view>
