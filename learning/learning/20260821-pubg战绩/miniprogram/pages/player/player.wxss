/* pages/player/player.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.top-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.back-btn {
  width: 92rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin: 0 24rpx;
}

.spacer {
  width: 92rpx;
}

.compare-btn-text {
  width: 92rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  background: rgba(99, 132, 255, 0.2);
  border: 2rpx solid rgba(99, 132, 255, 0.4);
  border-radius: 16rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 0;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  animation: pulse 1.5s ease-in-out infinite;
  margin-bottom: 20rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.9); }
}

.loading-text {
  font-size: 28rpx;
  color: #8899aa;
}

.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 0;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #e94560;
  margin-bottom: 30rpx;
  text-align: center;
  max-width: 580rpx;
  line-height: 1.5;
}

.retry-btn {
  width: 240rpx;
  height: 72rpx;
  line-height: 64rpx;
  background: rgba(233, 69, 96, 0.2);
  border: 2rpx solid #e94560;
  color: #e94560;
  border-radius: 36rpx;
  font-size: 26rpx;
  text-align: center;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.player-header {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.player-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  overflow: hidden;
  margin-right: 24rpx;
  border: 4rpx solid rgba(233, 69, 96, 0.4);
}

.player-avatar image {
  width: 100%;
  height: 100%;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.player-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.player-meta {
  font-size: 24rpx;
  color: #8899aa;
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.mode-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #667788;
  border: 2rpx solid transparent;
}

.mode-tab.active {
  background: rgba(233, 69, 96, 0.15);
  color: #e94560;
  border-color: rgba(233, 69, 96, 0.4);
  font-weight: 600;
}

.mode-tab.disabled {
  opacity: 0.45;
  color: #445566;
}

.empty-mode {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #e94560;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8899aa;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
}

.stat-card.accent {
  border-color: rgba(233, 69, 96, 0.3);
}

.stat-card.highlight {
  background: rgba(233, 69, 96, 0.12);
  border-color: rgba(233, 69, 96, 0.4);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.stat-card.highlight .stat-value {
  color: #e94560;
  font-size: 40rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #667788;
}

.detail-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e94560;
  display: block;
  margin-bottom: 12rpx;
}

.detail-table {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
}

.table-row {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.04);
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.header {
  background: rgba(233, 69, 96, 0.1);
  font-weight: 600;
}

.col-1 {
  flex: 1;
  font-size: 26rpx;
  color: #8899aa;
}

.col-2 {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  text-align: right;
  font-weight: 500;
}

.table-row.header .col {
  color: #e94560;
  font-size: 26rpx;
}


.season-selector {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
}

.season-label {
  font-size: 24rpx;
  color: #8899aa;
}

.season-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.season-chip {
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #8899aa;
}

.season-chip.active {
  background: rgba(233, 69, 96, 0.15);
  border-color: rgba(233, 69, 96, 0.4);
  color: #e94560;
  font-weight: 600;
}

.chip-text {
  line-height: 1.4;
}


.radar-section {
  margin-bottom: 30rpx;
}

.radar-container {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
}

.radar-canvas {
  width: 100%;
  height: 400rpx;
}

.data-source {
  text-align: center;
  padding: 30rpx 0 40rpx;
}

.source-text {
  font-size: 22rpx;
  color: #445566;
}
