page { padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); }
.title { font-size: 36rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 12rpx; }
.subtitle { font-size: 26rpx; color: #666; line-height: 1.6; }