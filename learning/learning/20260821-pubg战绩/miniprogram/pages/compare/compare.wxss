/* pages/compare/compare.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.top-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.back-btn {
  width: 92rpx; height: 64rpx; line-height: 64rpx; text-align: center;
  font-size: 26rpx; color: #fff; background: rgba(255,255,255,0.08); border-radius: 16rpx;
}
.page-title {
  flex: 1; text-align: center; font-size: 32rpx; font-weight: 700; color: #fff; margin: 0 24rpx;
}
.spacer { width: 92rpx; }

.loading {
  display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 200rpx 0;
}
.loading-icon { width: 80rpx; height: 80rpx; margin-bottom: 20rpx; animation: pulse 1.5s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.9)} }
.loading-text { font-size: 28rpx; color: #8899aa; }

.error-box {
  display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 200rpx 0;
}
.error-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.error-text { font-size: 28rpx; color: #e94560; margin-bottom: 30rpx; text-align: center; max-width: 580rpx; }

.compare-form { width: 100%; }

.player-input-group {
  display: flex; align-items: stretch; gap: 12rpx; margin-bottom: 24rpx;
}

.player-slot {
  flex: 1; display: flex; flex-direction: column; gap: 8rpx;
}
.slot-label {
  font-size: 22rpx; color: #8899aa; padding-left: 8rpx;
}
.slot-input {
  height: 72rpx; background: rgba(255,255,255,0.08); border: 2rpx solid rgba(255,255,255,0.15);
  border-radius: 14rpx; padding: 0 20rpx; font-size: 26rpx; color: #fff;
}
.slot1 .slot-input { border-color: rgba(233,69,96,0.3); }
.slot2 .slot-input { border-color: rgba(99,132,255,0.3); }
.quick-tags { display: flex; gap: 10rpx; flex-wrap: wrap; }
.quick-tag {
  padding: 6rpx 16rpx; font-size: 20rpx; border-radius: 20rpx;
  background: rgba(255,255,255,0.06); border: 2rpx solid rgba(255,255,255,0.1); color: #8899aa;
}

.vs-divider {
  display: flex; align-items: center; justify-content: center;
  padding: 0 4rpx;
}
.vs-text {
  font-size: 24rpx; font-weight: 700; color: #e94560;
  font-style: italic;
}

.mode-tabs {
  display: flex; gap: 12rpx; margin-bottom: 24rpx;
}
.mode-tab {
  flex: 1; height: 56rpx; line-height: 56rpx; text-align: center;
  background: rgba(255,255,255,0.06); border-radius: 12rpx;
  font-size: 24rpx; color: #667788; border: 2rpx solid transparent;
}
.mode-tab.active {
  background: rgba(233,69,96,0.15); color: #e94560; border-color: rgba(233,69,96,0.4); font-weight: 600;
}

.compare-btn {
  width: 100%; height: 76rpx; line-height: 48rpx; text-align: center;
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #fff; border-radius: 16rpx; font-size: 28rpx; font-weight: 700; border: none;
  margin-bottom: 20rpx;
}

/* Results section */
.compare-results { width: 100%; }

.result-header {
  display: flex; align-items: stretch; gap: 12rpx; margin-bottom: 24rpx;
}
.result-player {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  background: rgba(255,255,255,0.06); border-radius: 16rpx;
  padding: 20rpx 12rpx; border: 2rpx solid rgba(255,255,255,0.08);
}
.result-player1 { border-color: rgba(233,69,96,0.3); }
.result-player2 { border-color: rgba(99,132,255,0.3); }
.result-avatar {
  width: 80rpx; height: 80rpx; border-radius: 40rpx; margin-bottom: 10rpx;
}
.result-name { font-size: 26rpx; font-weight: 700; color: #fff; margin-bottom: 4rpx; }
.result-season { font-size: 20rpx; color: #8899aa; }
.result-player.no-data { opacity: 0.5; }

.vs-middle {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 0 4rpx;
}
.vs-big { font-size: 36rpx; font-weight: 700; color: #e94560; font-style: italic; }
.vs-mode { font-size: 20rpx; color: #8899aa; margin-top: 4rpx; }

.compare-table {
  background: rgba(255,255,255,0.04); border-radius: 16rpx;
  border: 2rpx solid rgba(255,255,255,0.06); overflow: hidden;
}

.compare-row {
  display: flex; align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 2rpx solid rgba(255,255,255,0.04);
}
.compare-row:last-child { border-bottom: none; }

.compare-cell {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 6rpx 10rpx; border-radius: 10rpx;
}
.compare-cell.winner { background: rgba(46,204,113,0.15); }
.compare-cell.loser { background: rgba(233,69,96,0.1); }
.compare-cell.draw { background: rgba(255,255,255,0.04); }

.cell-value { font-size: 28rpx; font-weight: 700; color: #fff; }
.compare-cell.winner .cell-value { color: #2ecc71; }
.compare-cell.loser .cell-value { color: #e94560; }

.cell-label { font-size: 18rpx; color: #8899aa; margin-top: 2rpx; }
.compare-label {
  flex: 0 0 auto; font-size: 22rpx; color: #667788; padding: 0 16rpx; text-align: center;
  font-weight: 600;
}

.radar-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx; font-weight: 600; color: #e94560; display: block; margin-bottom: 12rpx;
}

.radar-container {
  background: rgba(255, 255, 255, 0.04); border-radius: 16rpx; padding: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
}

.radar-canvas {
  width: 100%; height: 400rpx;
}

.radar-legend {
  display: flex; justify-content: center; gap: 30rpx; margin-top: 16rpx;
}

.legend-item {
  display: flex; align-items: center; gap: 8rpx;
}

.legend-color {
  width: 16rpx; height: 16rpx; border-radius: 8rpx;
}

.legend-text {
  font-size: 22rpx; color: #8899aa;
}
