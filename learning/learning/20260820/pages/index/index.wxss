.page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  background: linear-gradient(180deg, #4a90d9 0%, #6fb1e8 45%, #eaf2fb 100%);
}

/* 加载/错误状态 */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
  color: #ffffff;
  font-size: 30rpx;
}
.state-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}
.error-text {
  text-align: center;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
  font-size: 32rpx;
}
.retry-btn {
  background: rgba(255, 255, 255, 0.92);
  color: #4a90d9;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 56rpx;
  line-height: 76rpx;
  font-weight: 500;
}

/* 顶部城市与搜索 */
.topbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.city {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
  flex-shrink: 1;
  min-width: 0;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333;
}

/* 当前天气大卡片 */
.hero {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 32rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  color: #ffffff;
  margin-bottom: 24rpx;
}
.hero-city {
  font-size: 36rpx;
  font-weight: 600;
  opacity: 0.95;
  margin-bottom: 10rpx;
}
.hero-country {
  display: inline-block;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.95;
  vertical-align: middle;
}
.hero-icon {
  font-size: 120rpx;
  line-height: 1.2;
}
.hero-temp {
  font-size: 120rpx;
  font-weight: 200;
  line-height: 1.1;
  overflow: hidden;
}
.hero-text {
  font-size: 36rpx;
  margin-top: 8rpx;
}
.hero-meta {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
  word-break: break-all;
}
.hero-update {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 8rpx;
}

/* 详情网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}
.grid-item {
  width: 50%;
  box-sizing: border-box;
  padding: 24rpx 12rpx;
  text-align: center;
  overflow: hidden;
}
.grid-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.grid-label {
  font-size: 24rpx;
  color: #95a5a6;
  margin-top: 6rpx;
}

/* 未来三天 */
.forecast {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}
.forecast-item {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-top: 1rpx solid #f0f3f6;
  min-width: 0;
}
.forecast-day {
  width: 100rpx;
  flex-shrink: 0;
  color: #7f8c8d;
  font-size: 28rpx;
}
.forecast-icon {
  width: 70rpx;
  flex-shrink: 0;
  font-size: 40rpx;
  text-align: center;
}
.forecast-text {
  flex: 1;
  min-width: 0;
  color: #2c3e50;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.forecast-temp {
  flex-shrink: 0;
  color: #2c3e50;
  font-size: 28rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.tip {
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 28rpx;
}

/* 城市选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.picker-modal {
  width: 600rpx;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.picker-title {
  padding: 32rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  border-bottom: 1rpx solid #f0f3f6;
}
.picker-list {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 0;
}
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.picker-item:active {
  background: #f8f9fa;
}
.picker-city {
  font-size: 30rpx;
  color: #2c3e50;
}
.picker-original {
  font-size: 24rpx;
  color: #95a5a6;
  margin-left: 8rpx;
}
.picker-country {
  font-size: 24rpx;
  color: #95a5a6;
  padding: 4rpx 16rpx;
  background: #f0f3f6;
  border-radius: 16rpx;
}
.picker-cancel {
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  color: #95a5a6;
  border-top: 1rpx solid #f0f3f6;
}