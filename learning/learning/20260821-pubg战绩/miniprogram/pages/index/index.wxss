/**index.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  background: rgba(255,255,255,0.1);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #e94560;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8899aa;
}

.search-box {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #fff;
}

.search-btn {
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.search-btn[loading] {
  opacity: 0.7;
}

.quick-tips {
  width: 100%;
}

.tip-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.tip-title {
  font-size: 26rpx;
  color: #667788;
  display: block;
}

.clear-btn {
  font-size: 24rpx;
  color: #e94560;
  padding: 8rpx 20rpx;
  background: rgba(233, 69, 96, 0.1);
  border-radius: 12rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 28rpx;
  background: rgba(233, 69, 96, 0.15);
  border: 2rpx solid rgba(233, 69, 96, 0.3);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #e94560;
}

.history-tag {
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  color: #aaa;
}

.footer {
  position: fixed;
  bottom: 40rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #445566;
}
